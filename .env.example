# ==============================================================================
# Face ID + Blockchain Verification Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Search: Google AI Studio Gemini API (Web Discovery with Search Grounding)
# ------------------------------------------------------------------------------
# Google AI Studio API key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Fallback Search: SerpApi (Google Lens & Reverse Image Engine)
# ------------------------------------------------------------------------------
SERPAPI_KEY=your_serpapi_key_here

# ------------------------------------------------------------------------------
# 3. Tertiary Fallback: TinEye API (Optional)
# ------------------------------------------------------------------------------
TINEYE_API_KEY=your_tineye_api_key_here
TINEYE_API_SECRET=your_tineye_api_secret_here

# ------------------------------------------------------------------------------
# 4. Search Representation Toggles
# ------------------------------------------------------------------------------
# Enable/disable search representations (both enabled by default)
SEARCH_USE_FULL_IMAGE=true
SEARCH_USE_FACE_CROP=true

# ------------------------------------------------------------------------------
# 5. Face Detection & Matching Configuration (Biometric Authority)
# ------------------------------------------------------------------------------
# Selection mode when multiple faces are detected: "largest" (default) or "interactive"
FACE_SELECTION_MODE=largest

# Minimum face size in pixels (width and height)
FACE_MIN_SIZE=80

# Blur threshold (Laplacian variance; lower means more lenient)
FACE_BLUR_THRESHOLD=60.0

# Cosine similarity threshold (calibrate with scripts/calibrate_threshold.py)
# FaceNet InceptionResnetV1 recommended threshold: 0.60 - 0.70
SIMILARITY_THRESHOLD=0.60

# Required minimum confidence margin between top-1 and top-2 candidate
MATCH_CONFIDENCE_MARGIN=0.05

# Human match review mode: "off" (default for autonomous execution) or "interactive"
MATCH_REVIEW_MODE=off

# ------------------------------------------------------------------------------
# 6. Blockchain Configuration (Polygon Amoy Testnet / Local EVM)
# ------------------------------------------------------------------------------
# Blockchain RPC URL:
# Recommended: Dedicated authenticated RPC provider from Alchemy or Infura:
#   Alchemy: https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
#   Infura:  https://polygon-amoy.infura.io/v3/YOUR_INFURA_API_KEY
# Reliable Public Endpoints:
#   dRPC:        https://polygon-amoy.drpc.org
#   PublicNode:  https://polygon-amoy-bor-rpc.publicnode.com
#   Ankr:        https://rpc.ankr.com/polygon_amoy
BLOCKCHAIN_RPC_URL=https://polygon-amoy.drpc.org

# Chain ID (80002 for Polygon Amoy Testnet; 1337 or 31337 for local EVM)
CHAIN_ID=80002

# Deployed FaceMatchRegistry contract address (obtained by running: python scripts/deploy_contract.py)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key of funded Polygon Amoy wallet (used to sign submitRecord transactions)
# Fund your wallet with testnet POL from:
#   1. https://faucet.polygon.technology/
#   2. https://www.alchemy.com/faucets/polygon-amoy
#   3. https://faucets.chain.link/polygon-amoy
WALLET_PRIVATE_KEY=your_64_hex_char_private_key_here

# Explicit local EVM simulation mode (true: runs in-process EVM via eth-tester, false: connects to Amoy RPC)
# Never silently switched; must be explicitly enabled for offline demo/testing
USE_LOCAL_CHAIN=false

# ------------------------------------------------------------------------------
# 7. Local Cache & Server Configuration
# ------------------------------------------------------------------------------
CACHE_DB_PATH=./cache.db
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
